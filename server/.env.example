# --- Serveur ---
NODE_ENV=development
PORT=4000
# Origines autorisees a appeler l'API (separees par des virgules)
CLIENT_ORIGIN=http://localhost:5173

# --- Base de donnees PostgreSQL ---
# Soit une URL complete...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
# ...soit les variables detaillees (utilisees si DATABASE_URL est absente)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ecommerce

# --- Authentification ---
# A remplacer imperativement en production (chaine aleatoire de 32+ caracteres)
JWT_SECRET=changez-cette-cle-secrete-en-production
JWT_EXPIRES_IN=7d

# --- Boutique ---
FRAIS_LIVRAISON=500
DEVISE=cfa

# --- Compte administrateur cree par le seed ---
ADMIN_EMAIL=admin@3mt-shopping.sn
ADMIN_PASSWORD=Admin123!
